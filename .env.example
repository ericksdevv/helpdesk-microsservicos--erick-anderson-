# Copie para .env e ajuste se desejar. O arquivo .env nunca deve ir para o GitHub.

# Segredo compartilhado pelos microsserviços para assinar e validar tokens JWT (mínimo 32 caracteres).
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Se ficar vazio no Docker Compose, o serviço init-segredo gera um segredo aleatório único no volume compartilhado.
JWT_SEGREDO=

# Tempo de validade do login, em minutos
TOKEN_MINUTOS=60

# 1 = cria usuários, equipamentos e chamados de exemplo (só para aula)
DADOS_EXEMPLO=1
# Senha dos usuários de exemplo
SENHA_EXEMPLO=Helpdesk2026

# 0 = desliga a documentação /docs (recomendado em produção)
DOCS=1

# Resiliência nas chamadas HTTP entre serviços
HTTP_TIMEOUT_SEGUNDOS=2.5
CIRCUIT_BREAKER_LIMITE_FALHAS=2
CIRCUIT_BREAKER_RESET_SEGUNDOS=5.0
